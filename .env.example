# Copy to .env (`bun run dev` does this for you on first run).

# Postgres (docker compose maps the container to this host port)
POSTGRES_PORT=54329
DATABASE_URL=postgres://autosoccer:autosoccer@localhost:54329/autosoccer

# API server (apps/server)
API_PORT=4000
LOG_LEVEL=info
# Replay files (gzip JSON) written by the match worker; relative paths resolve from the repo root
REPLAY_DIR=data/replays
WORKER_POLL_MS=1000

# Public web app (apps/web) — server-side loaders call the API at this URL
API_URL=http://localhost:4000
WEB_PORT=3000

# AI managers: "anthropic" (needs ANTHROPIC_API_KEY) or "offline" (deterministic stand-in)
# LLM_PROVIDER=offline
MANAGER_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=

# Orchestration
SCHEDULER_ENABLED=true
SCHEDULE_RESPECT_KICKOFF=true
SCHEDULER_INTERVAL_MS=5000
WORKER_LEASE_MS=300000
# OPS_TOKEN=change-me
EDITORIAL_MODEL=claude-opus-5-5
