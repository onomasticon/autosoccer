{
  "name": "autosoccer",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.19",
  "engines": {
    "bun": "1.2.19"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "vendor/autosoccer-sim/packages/*"
  ],
  "scripts": {
    "setup": "bun install && bun run db:up && bun run db:migrate",
    "dev": "bun scripts/dev.ts",
    "start": "bun scripts/dev.ts --prod",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "bun packages/db/src/migrate-cli.ts",
    "build": "bun run --cwd apps/web build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit && bun run --cwd apps/web typecheck",
    "test": "vitest run",
    "smoke": "bun scripts/smoke.ts",
    "contracts:gen": "bun packages/contracts/src/generate.ts",
    "sim:check": "bun scripts/sim-check.ts",
    "worker": "bun --cwd apps/server src/worker.ts",
    "league": "bun scripts/league.ts",
    "ui:check": "node scripts/ui-check.mjs",
    "tactics:compare": "bun scripts/tactics-compare.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.5",
    "@types/node": "22.18.8",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "@types/bun": "1.2.19",
    "playwright": "1.49.1"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide"
  ]
}
