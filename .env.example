# Copy to .env (`bun run dev` does this for you on first run).

# Postgres (docker compose maps the container to this host port)
POSTGRES_PORT=54329
DATABASE_URL=postgres://autosoccer:autosoccer@localhost:54329/autosoccer

# API server (apps/server)
API_PORT=4000
LOG_LEVEL=info

# Public web app (apps/web) — server-side loaders call the API at this URL
API_URL=http://localhost:4000
WEB_PORT=3000
