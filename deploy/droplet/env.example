# Copy to /opt/autosoccer/.env on the Droplet (chmod 600). Read by every service and by compose.

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel → install token)
TUNNEL_TOKEN=

# DigitalOcean Managed PostgreSQL 16: the *direct* connection (port 25060), not the pool.
# Workers hold a session-level advisory lock (scheduler leader) that a transaction pool would drop.
DATABASE_URL=postgresql://doadmin:PASSWORD@db-postgresql-xxx-do-user-000-0.d.db.ondigitalocean.com:25060/autosoccer?sslmode=verify-full
DATABASE_CA_CERT_FILE=/run/secrets/db-ca.crt
# Connections: api pool + 2 workers × worker pool must stay under the plan's limit (check the
# database's "connection limit" in the control panel). 5 + 2×4 = 13.
API_DB_POOL_MAX=5
WORKER_DB_POOL_MAX=4

# Replays in Cloudflare R2 (R2 → Manage API tokens → Object Read & Write, scoped to the bucket)
REPLAY_STORE=r2
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=autosoccer-replays
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# AI managers and journalists
ANTHROPIC_API_KEY=
MANAGER_MODEL=claude-opus-5-5
EDITORIAL_MODEL=claude-opus-5-5

# Operations
OPS_TOKEN=
LOG_LEVEL=info
SCHEDULER_ENABLED=true
SCHEDULE_RESPECT_KICKOFF=true
WORKER_LEASE_MS=300000
