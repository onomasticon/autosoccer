# Copy to ~/autosoccer/.env on the exe.dev VM (chmod 600). Read by compose and by every app service.

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel → install token)
TUNNEL_TOKEN=

# Postgres runs in the stack; compose builds DATABASE_URL from this. Keep it URL-safe:
#   openssl rand -hex 24
POSTGRES_PASSWORD=
# api pool + 2 workers × worker pool = 5 + 2×4 = 13 of the database's 40 connections.
API_DB_POOL_MAX=5
WORKER_DB_POOL_MAX=4

# Cloudflare R2 (R2 → Manage API tokens → Object Read & Write, scoped to both buckets)
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Replays
REPLAY_STORE=r2
R2_BUCKET=autosoccer-replays
# Nightly database dumps from backup.sh (a separate, private bucket)
R2_BACKUP_BUCKET=autosoccer-backups

# AI managers and journalists
ANTHROPIC_API_KEY=
MANAGER_MODEL=claude-opus-5-5
EDITORIAL_MODEL=claude-opus-5-5

# Operations
OPS_TOKEN=
LOG_LEVEL=info
SCHEDULER_ENABLED=true
SCHEDULE_RESPECT_KICKOFF=true
# Start the next season automatically when one completes (same clubs, budgets and round spacing; 7-a-side)
SEASON_ROLLOVER=true
WORKER_LEASE_MS=300000
