# Copy to .env (`bun run dev` does this for you on first run).

# Postgres (docker compose maps the container to this host port)
POSTGRES_PORT=54329
DATABASE_URL=postgres://autosoccer:autosoccer@localhost:54329/autosoccer

# API server (apps/server)
API_PORT=4000
LOG_LEVEL=info
# Replay storage: "file" (REPLAY_DIR, relative to the repo root) or "r2" (Cloudflare R2 / any S3 API)
REPLAY_STORE=file
REPLAY_DIR=data/replays
# R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# R2_BUCKET=autosoccer-replays
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Database TLS (managed Postgres): add ?sslmode=verify-full to DATABASE_URL and point this at the CA file
# DATABASE_CA_CERT_FILE=
# Pool sizes (api + workers × worker pool must fit the database's connection limit)
# API_DB_POOL_MAX=10
# WORKER_DB_POOL_MAX=6
WORKER_POLL_MS=1000

# Public web app (apps/web) — server-side loaders call the API at this URL
API_URL=http://localhost:4000
WEB_PORT=3000

# AI managers: "anthropic" (needs ANTHROPIC_API_KEY) or "offline" (deterministic stand-in)
# LLM_PROVIDER=offline
MANAGER_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=

# Orchestration
SCHEDULER_ENABLED=true
SCHEDULE_RESPECT_KICKOFF=true
# Start the next season automatically when one completes (same clubs, budgets and round spacing; 7-a-side)
SEASON_ROLLOVER=true
SCHEDULER_INTERVAL_MS=5000
WORKER_LEASE_MS=300000
# OPS_TOKEN=change-me
EDITORIAL_MODEL=claude-opus-5-5
